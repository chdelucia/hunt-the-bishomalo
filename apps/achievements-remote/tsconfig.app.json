{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "types": []
  },
  "include": [
    "src/**/*.ts",
    "../../libs/achievements/**/*.ts",
    "../../libs/achievements/api/src/index.ts",
    "../../libs/core/api/src/index.ts",
    "../../libs/core/data-access/src/index.ts",
    "../../libs/shared/data/src/index.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "../../libs/achievements/**/*.spec.ts",
    "../../libs/achievements/**/*.test.ts",
    "jest.config.ts",
    "src/test-setup.ts"
  ],
  "angularCompilerOptions": {
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
      }
    }
  }
}